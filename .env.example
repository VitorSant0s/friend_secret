# Doações via PIX (opcional)
# Chave PIX do recebedor: telefone, e-mail, CPF/CNPJ ou chave aleatória.
PIX_KEY=
# Nome de quem recebe (até 25 letras) e cidade (até 15 letras)
PIX_NAME=
PIX_CITY=

# ---- Motor na VPS (Docker) ----
# Domínio público do motor; o nginx emite o HTTPS com o Let's Encrypt
DOMAIN=api.seudominio.com
# E-mail usado no certificado (avisos de renovação). Opcional.
CERTBOT_EMAIL=voce@seudominio.com
# Sessões simultâneas permitidas (cada navegador conectado é uma)
MAX_SESSIONS=25
# CORS: vazio = só o próprio domínio acessa a API.
# Defina a URL do site se ele ficar em outro domínio (ex.: Netlify).
# Use * apenas se souber o que está fazendo.
ALLOWED_ORIGIN=https://seudominio.netlify.app

# ---- Frontend no Netlify ----
# Defina esta variável no painel do Netlify, apontando para o motor
# NEXT_PUBLIC_API_URL=https://api.seudominio.com
